import java.time.*;

public class Main {
	public static void main(String[] args) {
		LocalDateTime inicio = LocalDateTime.of(
			LocalDate.of(2026, Month.FEBRUARY, 15),
			LocalTime.of(9, 44, 52)
		);
		LocalDateTime fim = LocalDateTime.of(
			LocalDate.of(2026, Month.MARCH, 13),
			LocalTime.of(17, 6, 3)
		);

		Duration duracao = Duration.between(inicio, fim);

		String total = String.format(
			"O tempo gasto foi de: %d dias, %d horas e %d minutos",
			duracao.toDaysPart(),
			duracao.toHoursPart(),
			duracao.toMinutesPart()
		);

		System.out.println(total);
		System.out.println("Execução realizada com sucesso!");
	}
}
